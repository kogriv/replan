# Settings that helpers read only from the process environment.
# Both load-dotenv.sh and openproject_http.py use this list to warn when a
# non-empty value is present in a settings file. These names must stay absent
# from settings.list: finding one never makes the loader accept it.
REPLAN_ENV_FILE
REPLAN_APPLY
REPLAN_ACTOR
REPLAN_BIN
REPLAN_FORMAT
REPLAN_KEEP_TEMP
REPLAN_TASK
REPLAN_TASKS
REPLAN_ACCEPTED_BY
REPLAN_ACCEPT_SUMMARY
REPLAN_ACCEPT_EVIDENCE_ID
REPLAN_ACCEPT_AT
REPLAN_ACCEPT_CI_MINUTES
REPLAN_RESOURCE_ID
REPLAN_UNIT
REPLAN_OPENPROJECT_PROFILE
REPLAN_OPENPROJECT_FROM_FILE
REPLAN_OPENPROJECT_STATUS_SCOPE
REPLAN_OPENPROJECT_STATUS_PATH
REPLAN_OPENPROJECT_SINCE
REPLAN_OPENPROJECT_INCLUDE_CLOSED
REPLAN_OPENPROJECT_INCLUDE_RELATIONS
REPLAN_OPENPROJECT_INCLUDE_TIME_ENTRIES
REPLAN_OPENPROJECT_IMPORT_JSON
REPLAN_OPENPROJECT_SAMPLE
REPLAN_OPENPROJECT_DEPENDENCY_DRY_RUN
REPLAN_OPENPROJECT_RESOURCE_LINKS_SIDECAR
REPLAN_OPENPROJECT_RESOURCE_DEMANDS_SIDECAR
REPLAN_OPENPROJECT_ACCEPT_TRACKING_STATUS
REPLAN_OPENPROJECT_KEEP_AUTOMATIC_SCHEDULING
REPLAN_OPENPROJECT_REPLAN_LINK_FIELD
REPLAN_EXPECT_RESOURCE_LINKS_MIN
REPLAN_EXPECT_RESOURCE_DEMANDS_MIN
REPLAN_EXPECT_TIME_ACCEPT_CHANGES_MIN
REPLAN_EXPECT_TRACKING_STATUS_CHANGES_MIN
