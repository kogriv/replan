# Settings of the RePlan agent kit. Copy to .env.local and fill in.
# .env.local holds a secret: never commit it.

# The address people open OpenProject at.
REPLAN_OPENPROJECT_BASE_URL=https://openproject.example.org

# The project's identifier, as in its address: /projects/<identifier>.
REPLAN_OPENPROJECT_PROJECT_ID=my-project
REPLAN_OPENPROJECT_PROJECT_NAME=My project
# Deprecated for one release; use the names above:
# REPLAN_OPENPROJECT_TARGET_PROJECT_ID=my-project
# REPLAN_OPENPROJECT_TARGET_PROJECT_NAME=My project

# Your RePlan project directory, the plan.
REPLAN_PROJECT=/home/me/my-project/planning

# Which RePlan task is which work package. Created by the helpers; holds real
# work-package numbers, so keep it out of a public repository.
REPLAN_OPENPROJECT_BINDINGS_PATH=/home/me/my-project/planning/private/openproject-bindings.yaml

# Where the local overlay build is written. Leave empty for the kit default,
# tmp/openproject-live-overlay/latest under the kit root.
REPLAN_OVERLAY_OUTPUT_DIR=

# The OpenProject server's overlay directory as rsync addresses it: a local
# path or host:path. This private target has no default.
REPLAN_OVERLAY_PUBLISH_TARGET=

# Your own API token: OpenProject, My account, Access tokens, API.
OPENPROJECT_TOKEN=

# Only if your OpenProject sits behind a reverse proxy that asks API clients
# for a perimeter key: the key its administrator gave you, a secret like the
# token. The header name is X-Perimeter-Key unless you are told another.
#REPLAN_OPENPROJECT_PERIMETER_KEY=
#REPLAN_OPENPROJECT_PERIMETER_HEADER=X-Perimeter-Key

# Optional: assign new work packages to another member instead of yourself.
#REPLAN_OPENPROJECT_ASSIGNEE_USER_ID=
#REPLAN_OPENPROJECT_ASSIGNEE_NAME=
# Optional: the RePlan resource that person is, for example
# resource.human.anna; bootstrap then binds the OpenProject user to it.
#REPLAN_OPENPROJECT_ASSIGNEE_RESOURCE_ID=
